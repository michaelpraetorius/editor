# macOS
.DS_Store
**/.DS_Store

# Logs / temp
*.log

# Lokale Claude-Einstellungen (Berechtigungen, Pfade) - nicht teilen
.claude/settings.local.json

# Brand assets are NOT committed - only the folder structure is kept.
# Put your own files locally in assets/backgrounds, assets/overlays, assets/artwork.
assets/backgrounds/*
assets/overlays/*
assets/artwork/*
!assets/backgrounds/.gitkeep
!assets/overlays/.gitkeep
!assets/artwork/.gitkeep
